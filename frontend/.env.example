# GeneGuard Cloud Deployment Environment Variables

# Base URL for the Python ML Backend API (Cardiovascular, Diabetes, Hypertension, Thyroid, Cancer models, Family Network, OCR)
# Local development default: http://localhost:5000/api
# When deploying frontend on Vercel and backend on Render / Railway / Fly.io / VPS:
# Example: VITE_API_BASE_URL="https://geneguard-api.onrender.com/api"
VITE_API_BASE_URL="http://localhost:5000/api"

# Base URL for the Medical Reference Chatbot Service
# Local development default: relative / (via Vite proxy to http://localhost:8080)
# When deploying to production:
# Example: VITE_CHATBOT_URL="https://geneguard-chatbot.onrender.com"
VITE_CHATBOT_URL=""
